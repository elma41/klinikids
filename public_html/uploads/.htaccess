# Yüklenen dosyalar: listeleme kapalı, burada hiçbir betik çalışmaz
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.svg$">
    Header set Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox"
  </FilesMatch>
</IfModule>
